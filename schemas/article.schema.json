{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "sourceId",
    "sourceName",
    "tier",
    "category",
    "collectedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "imageUrl": {
      "type": [
        "string",
        "null"
      ]
    },
    "sourceId": {
      "type": "string"
    },
    "sourceName": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "official",
        "scientific",
        "journalism"
      ]
    },
    "category": {
      "type": "string"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "collectedAt": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
